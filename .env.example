# Copy to `.env` for local development. `.env` is gitignored and must stay that
# way — see .gitignore.
#
# Nothing in this file is a secret: these are build-time identifiers only. The
# app's own network credentials — a transcription key, bucket credentials, a
# backup passphrase — are never here either. They are typed into Settings on the
# device and stored in the encrypted vault, so there is nothing for this file to
# hold. Real release credentials (App Store Connect key, certificates) live
# exclusively in GitHub Secrets and are never present on a developer machine.

# Reverse-DNS bundle identifier. Must be globally unique across the App Store
# and must match the App ID registered in your Apple Developer account.
# The build appends `.dev` / `.preview` for non-production variants.
IOS_BUNDLE_IDENTIFIER=com.example.activitytracker

# Apple Developer Team ID — 10 characters, from developer.apple.com → Membership.
# Not a secret (it is embedded in every provisioning profile), but kept out of
# committed source so the repository holds no account-specific values.
# CI reads this from the APPLE_TEAM_ID repository variable, not from here.
APPLE_TEAM_ID=

# Which variant to build: development | preview | production
APP_VARIANT=development

# Normally set by CI from the release tag; override locally only if you need to
# reproduce a specific build.
# APP_VERSION=0.1.0
# IOS_BUILD_NUMBER=1

# Populated by `eas init` if you choose to use Expo Application Services in
# addition to the GitHub Actions pipeline. Not a secret — a public project handle.
# EAS_PROJECT_ID=
